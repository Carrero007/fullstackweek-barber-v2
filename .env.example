# PostgreSQL (ex.: Neon) - conexão com pooler, usada pela aplicação
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true"
# Conexão direta, usada pelas migrations do Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth
NEXT_AUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
